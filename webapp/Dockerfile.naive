# "BEFORE" image for Task 6.4 only - intentionally unoptimised for the size comparison:
# full Debian python base, pip cache kept, full TensorFlow (with CUDA libs), source copied first
# (every code change re-installs all dependencies), runs as root.
# docker build -f webapp/Dockerfile.naive -t vg-web:naive .
FROM python:3.11
WORKDIR /app
COPY . .
RUN sed 's/tensorflow-cpu/tensorflow/' requirements-web.txt > /tmp/req.txt && pip install -r /tmp/req.txt
EXPOSE 5000
CMD ["gunicorn", "-b", "0.0.0.0:5000", "webapp.app:app"]
