# Copy to .env and fill in. .env is git-ignored and docker-ignored.

# ---- MLflow on DagsHub (Task 3) ----
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-username>/23L-0548_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
REGISTERED_MODEL_NAME=23L-0548_A2_Ops_VisionGuard

# ---- Database (Task 5 / 6) ----
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=visionguard

# ---- Flask web app (Task 4) ----
SECRET_KEY=change_me_random_string
MAX_UPLOAD_MB=5
# empty = use the threshold stored in models/champion/meta.json
THRESHOLD=
# local  = load the Keras model inside the web container
# remote = call the cloud model API (Task 7/8)
INFERENCE_MODE=local
MODEL_API_URL=https://<your-api-host>
MODEL_API_KEY=change_me_long_random_api_key
